greenware 1

// The football clip library: the athlete's body animations as Greenware
// source. It is a port of the clips in the game's cmd/bakeathletes/pose.go
// (body.pose, one case per action), and the numbers are that file's.
//
// A library declares clips and no asset. An asset installs every clip here
// with `use_clips { of = football }` after `import "clips/football.gw" as
// football`. The clips are written against the athlete's joint names and bind
// frames (identity orientation, the model faces -z): a pose rotation Q is in
// the bind frame, and `rot(x, y, z)` is x, then y, then z degrees about the
// joint's own axes, as the game's Euler. A bare angle is degrees. The root's
// height is in yards, the game's field unit, written with its suffix because
// a library has no `length` of its own. Mirror blocks name the left side and
// reflect the right (`side` is 1, then -1), which is the game's `sg`.
//
// What the game's clips need and `solved.gw` carries instead: the paired
// tackles blend two poses by quaternion and settle onto the turf with the
// skinned mesh, and the lateral footwork solves each leg to a cleat path
// numerically. They are stored there as key tables.
//
// Names, durations and key counts are the game's. `loop` is a request for
// wraparound; the game's file does not carry it, so it is set for the clips
// the game plays by phase (a cycle) and left off for the one-shots.

// Standing ready, hands low.
clip ready {
  duration = 0.9s
  keys = 13
  loop = on
  pose {
    chest = rot(-6, 0, 0)
    head = rot(3.3, 0, 0)
    mirror {
      plane = x
      let thigh = 15deg + 6deg * side
      let shin = -27deg - 3deg * side
      legl = rot(thigh, 0, 2)
      kneel = rot(shin, 0, 0)
      // the foot stays inside the ankle band: 40 down, 20 up
      anklel = rot(clamp(-(thigh + shin) * 0.7, -40, 20), 0, 0)
      arml = rot(8 + 4 * side, 3, 8)
      elbowl = rot(48 - 11 * side, 14, -8)
      handl = rot(0, 0, 0)
    }
    root = (0, 1yd - (0.46yd * (1 - cos(18deg)) + 0.008yd), 0)
  }
}

// The three-point stance before the snap.
clip stance {
  duration = 0.9s
  keys = 13
  loop = on
  pose {
    chest = rot(-35, 0, 0)
    head = rot(19.25, 0, 0)
    mirror {
      plane = x
      let thigh = 56deg + 7deg * side
      let shin = -81deg
      legl = rot(thigh, 0, 5)
      kneel = rot(shin, 0, 0)
      // the foot stays inside the ankle band: 40 down, 20 up
      anklel = rot(clamp(-(thigh + shin) * 0.7, -40, 20), 0, 0)
      arml = rot(if side > 0 then 12 else 40, 3, 16)
      elbowl = rot(if side > 0 then 19 else 54, 0, -8)
      handl = rot(0, 0, 0)
    }
    root = (0, 1yd - (0.46yd * (1 - cos(56deg)) + 0.035yd), 0)
  }
}

// The run cycle. The stride has a flight phase, so the ground band of `check rig` does not apply.
clip run {
  duration = 0.71s
  keys = 25
  loop = on
  airborne = on
  let wob = sin(360deg * t)
  pose {
    pelvis = rot(-7, 0, 0)
    chest = rot(-17, -8 * wob, 0)
    head = rot(9.35, 3 * wob, 0)
    mirror {
      plane = x
      let w = side * wob
      let thigh = 19deg + 38deg * w
      let shin = -max(10deg, 35deg - 35deg * w)
      legl = rot(thigh, 0, 2)
      kneel = rot(shin, 0, 0)
      // the foot stays inside the ankle band: 40 down, 20 up
      anklel = rot(clamp(-(thigh + shin) * 0.7, -40, 20), 0, 0)
      arml = rot(-15 - 32 * w, 3, 8)
      elbowl = rot(48 + 7 * w, 0, -8)
      handl = rot(0, 0, 0)
    }
    root = (0, 1yd - (0.46yd * (1 - cos(23deg)) + 0.008yd) + 0.028yd * (1 - abs(wob)), 0)
  }
}

// The run with the ball tucked in the right arm.
clip carry {
  duration = 0.75s
  keys = 25
  loop = on
  airborne = on
  let wob = sin(360deg * t)
  pose {
    pelvis = rot(-7, 0, 0)
    chest = rot(-19, -8 * wob, 0)
    head = rot(10.45, 3 * wob, 0)
    mirror {
      plane = x
      let w = side * wob
      let thigh = 19deg + 38deg * w
      let shin = -max(10deg, 35deg - 35deg * w)
      legl = rot(thigh, 0, 2)
      kneel = rot(shin, 0, 0)
      // the foot stays inside the ankle band: 40 down, 20 up
      anklel = rot(clamp(-(thigh + shin) * 0.7, -40, 20), 0, 0)
      arml = rot(if side < 0 then 13 else -15 - 32 * w, 3, 8)
      elbowl = rot(if side < 0 then 72 else 48 + 7 * w, 14, -8)
      handl = rot(0, 0, 0)
    }
    root = (0, 1yd - (0.46yd * (1 - cos(23deg)) + 0.008yd) + 0.028yd * (1 - abs(wob)), 0)
  }
}

// The fastest stride.
clip sprint {
  duration = 0.59s
  keys = 25
  loop = on
  airborne = on
  let wob = sin(360deg * t)
  pose {
    pelvis = rot(-7, 0, 0)
    chest = rot(-24, -8 * wob, 0)
    head = rot(13.2, 3 * wob, 0)
    mirror {
      plane = x
      let w = side * wob
      let thigh = 19deg + 40deg * w
      let shin = -max(10deg, 35deg - 35deg * w)
      legl = rot(thigh, 0, 2)
      kneel = rot(shin, 0, 0)
      // the foot stays inside the ankle band: 40 down, 20 up
      anklel = rot(clamp(-(thigh + shin) * 0.7, -40, 20), 0, 0)
      arml = rot(-15 - 32 * w, 3, 8)
      elbowl = rot(48 + 7 * w, 0, -8)
      handl = rot(0, 0, 0)
    }
    root = (0, 1yd - (0.46yd * (1 - cos(23deg)) + 0.008yd) + 0.028yd * (1 - abs(wob)), 0)
  }
}

// Crouched, arms out to block.
clip block {
  duration = 0.9s
  keys = 13
  loop = on
  pose {
    chest = rot(-37, 0, 0)
    head = rot(20.35, 0, 0)
    mirror {
      plane = x
      let thigh = 56deg + 7deg * side
      let shin = -63deg
      legl = rot(thigh, 0, 5)
      kneel = rot(shin, 0, 0)
      // the foot stays inside the ankle band: 40 down, 20 up
      anklel = rot(clamp(-(thigh + shin) * 0.7, -40, 20), 0, 0)
      arml = rot(62, 9, 8)
      elbowl = rot(42, 0, -8)
      handl = rot(0, 0, 0)
    }
    root = (0, 1yd - (0.46yd * (1 - cos(56deg)) + 0.008yd), 0)
  }
}

// The passer's throw: the trunk turns, the right arm cocks and releases.
clip throw {
  duration = 0.56s
  keys = 13
  let swing = sin(180deg * t)
  pose {
    chest = rot(3, -23 * swing, 0)
    head = rot(-1.65, 0, 0)
    mirror {
      plane = x
      let thigh = 12deg + 8deg * side
      let shin = -34deg
      legl = rot(thigh, 0, 2)
      kneel = rot(shin, 0, 0)
      // the foot stays inside the ankle band: 40 down, 20 up
      anklel = rot(clamp(-(thigh + shin) * 0.7, -40, 20), 0, 0)
      arml = rot(if side < 0 then 18 + 95 * swing else 24, 3, 8)
      elbowl = rot(if side < 0 then 88 - 70 * swing else 56, 0, -8)
      handl = rot(0, 0, 0)
    }
    root = (0, 1yd - (0.46yd * (1 - cos(18deg)) + 0.008yd), 0)
  }
}

// Both arms reach up for the ball.
clip catch {
  duration = 0.9s
  keys = 13
  loop = on
  let swing = sin(180deg * t)
  pose {
    chest = rot(-3, 0, 0)
    head = rot(1.65, 0, 0)
    mirror {
      plane = x
      let thigh = 20deg
      let shin = -34deg
      legl = rot(thigh, 0, 2)
      kneel = rot(shin, 0, 0)
      // the foot stays inside the ankle band: 40 down, 20 up
      anklel = rot(clamp(-(thigh + shin) * 0.7, -40, 20), 0, 0)
      arml = rot(74 + 9 * swing, 3, 8)
      elbowl = rot(21, 0, -8)
      handl = rot(0, 0, 0)
    }
    root = (0, 1yd - (0.46yd * (1 - cos(18deg)) + 0.008yd), 0)
  }
}

