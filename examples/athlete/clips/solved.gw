// Backpedal: the cycle loops on the stride, facing the play.
clip backpedal {
  duration = 0.41s
  keys = 25
  loop = on
  // The legs are solved to the cleat paths (a table); the trunk and arms are formulas.
  let wob = sin(360deg * t)
  let cs = cos(360deg * t)
  let k = round(t * 24)
  let legl_at = [
    rot(57.477694, 0, 2.820239), rot(59.591124, 0, 2.027841), rot(62.491704, 0, 0.913578),
    rot(64.346247, 0, -0.536477), rot(63.631638, 0, -2.204545), rot(59.833565, 0, -3.722391),
    rot(53.098069, 0, -4.565081), rot(44.148908, 0, -4.409593), rot(34.043327, 0, -3.415612),
    rot(23.788018, 0, -2.046027), rot(14.206249, 0, -0.704748), rot(6.594123, 0, 0.420827),
