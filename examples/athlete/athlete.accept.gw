greenware 1

// The owner's acceptance tests for the athlete (conformance 7.2 and 8, plan
// 4.5). They run on the decoded GLB of each output at every level and read
// nothing of the compiler. Every measure poses the delivered skin by the rules
// of language reference 5.6 at the runtime point it names.
//
// What this file measures today, and what it does not:
//
//   - The census facts (joints, targets, animation names) and the 48-point
//     product are measured and pass. The athlete installs the game's 27 body
//     clips (clips/football.gw and clips/solved.gw) and writes the four lookup
//     channels itself: 31 animations. The historical 23 (19 body clips and the
//     four channels) was the count of the old Python file; the game's bake has
//     27 body clips now.
//   - The body is the game's Go bake's (seven build targets, no height
//     parameter: the game scales a player as a whole model), so there are seven
//     morph targets and the combined point is build 1, belly 0, pads 0.5,
//     Brannoc. It is posed on `ready` key 0: the pelvis at 0.969486 yd, the
//     lowest sole vertex inside the ground band, and the head_gear frame.
//   - The helmet clearance is measured on the baked outputs (home, away), where
//     the old helmet gear is part of the file. It FAILS: the gear's shell and the
//     body's own helmet shell (the game's, with the same control levels) are
//     the same surface, so the gap is 0 mm, not 2 mm. For `match`
//     the helmet is its own file, which is not an input here, so the measure
//     is unavailable with that reason (exit status 3 when nothing else fails).
//   - Not measured at all: the waist section, seam and hip probes and the
//     swing-and-twist bands on the delivered file. They need the declared joint
//     ranges and the 5.9 probes; M5 solves the weights they audit.

accept athlete {
  of = "athlete.gw"
  outputs = [match, home, away]
  lods = all

  expect (joint_count() == 15, "15 joints")
  expect (morph_count() == 7, "seven morph targets: mass, belly, pads, chest-deep, limb-lean, waist-seat, leg-power")
  expect (animations_present("ready", "run", "field-x", "field-z", "stance-height", "heading") == 6, "the four lookup channels and two of the body clips")

  // The game's bake has 27 body clips and the four wrapper lookup channels.
  expect (animation_count() == 31, "31 animations")
  expect (animations_present("stance", "carry", "sprint", "block", "throw", "catch", "handoff", "juke", "tackle", "wrap-l", "wrap-r", "caught-l", "caught-r", "cut-l", "cut-r", "stumble", "kick") == 17, "the 17 other body clips of the historical file")
  expect (animations_present("backpedal", "shuffle-l", "shuffle-r", "crossover-l", "crossover-r", "hip-flip-l", "hip-flip-r", "kick-slide") == 8, "the 8 footwork clips of the game's bake")

  // 2^3 corners x 3 species of the file's own parameters, times two helmet
  // shells (classic, aero) = 48 extreme points.
  expect (runtime_points() * 2 == 48, "48 extreme runtime points")

  // `ready`, key 0, at the combined point. The root's up value is 0.969486 yd
  // with no added root offset, in metres.
  expect (abs(posed_position(pelvis, clip = ready, time = 0s, build = 1, belly = 0, pads = 0.5, species = brannoc).y - 0.969486 * 0.9144m) < 0.01mm, "pelvis at 0.969486 yd")
  expect (posed_lowest(clip = ready, time = 0s, build = 1, belly = 0, pads = 0.5, species = brannoc) >= -5mm, "the lowest sole vertex is at most 5 mm below the ground")
  expect (posed_lowest(clip = ready, time = 0s, build = 1, belly = 0, pads = 0.5, species = brannoc) <= 20mm, "the lowest sole vertex is at most 20 mm above the ground")
  expect (abs(posed_position(head_gear, clip = ready, time = 0s, build = 1, belly = 0, pads = 0.5, species = brannoc).x) < 1mm, "the head_gear socket stays on the centre line")
  expect (posed_position(head_gear, clip = ready, time = 0s, build = 1, belly = 0, pads = 0.5, species = brannoc).y > posed_position(pelvis, clip = ready, time = 0s, build = 1, belly = 0, pads = 0.5, species = brannoc).y + 0.5m, "head_gear is above the pelvis")

  // The defaults also stand on the ground, at both ends of `ready` and in the
  // unplayed display pose.
  expect (posed_lowest(clip = ready, time = 0s) >= -5mm && posed_lowest(clip = ready, time = 0s) <= 20mm, "default ready, key 0, stands on the ground")
  expect (posed_lowest(clip = ready, time = 0.9s) >= -5mm && posed_lowest(clip = ready, time = 0.9s) <= 20mm, "default ready, last key, stands on the ground")

  // Minimum clearance of the mounted helmet from the head, in the bind pose
  // and on `ready` key 0 (the baked classic shell; the aero shell is checked
  // by the build's own fit audit when the mount declares `fit`).
  expect (mounted_clearance(clip = ready, time = 0s) >= 2mm, "the mounted helmet keeps 2 mm from the head")

  when output == match {
    expect (draw_calls() == 1, "the match file draws the host alone: the helmet is its own model")
  }
  when output != match {
    expect (draw_calls() == 2, "a baked file draws the host and the helmet's palette material")
  }
}
