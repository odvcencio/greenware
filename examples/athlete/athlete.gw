greenware 1

// The football player: a rigged figure with build, height and species
// parameters, seven build morph targets, gear sockets, joint ranges and two
// clips. It is the body the game bakes in Go (cmd/bakeathletes figure.go,
// athletebody, helmet.go, rig.go), written as Greenware source in field yards.
// The ring tables are the game's, number for number; where the game's code
// wrote
//     R("belt", "pelvis", cellBelt, rings(...), 32)
// this file writes
//     loft belt { joint = pelvis  cell = belt  segments = 32  ring (...) ... }
// and where the game looped "for _, sd := range sides", this file writes the
// left (+x) side once inside "mirror { plane = x }", declaring each sided shape
// as a pair: loft (thigh_l, thigh_r), joint (arml, armr).
//
// Names. Every leaf shape is named as the game's bake names its shell (torso,
// collar, belt, shoulderpad, upperarm, forearm, hand, palm, thumb, finger,
// hips, thigh, thighpad, shin, kneeband, kneepad, cleat, sole, lace, neck,
// face, nose, brow, chin, cheek, eye, pupil, mouthguard, helmet, helmetrim,
// earcup, earhole, chinstrap, maskclip, chinpad, bumper, cheekpad). A shape
// that exists once on each side is a pair, so its census name is the pair
// member: thigh_l and thigh_r are the game's two "thigh" shells. An array
// copy is called by the array's name, so finger_l and finger_r are each four
// "finger" shells. The game's 72 shells are 72 leaf shapes here.
//
// Two structural choices follow the game's builder, not the language's
// defaults. A shell the game builds with SeamStack (hips, torso, face,
// shoulderpad, upperarm, forearm, thigh, shin, helmet) keeps its repeated seam
// column, and one it builds with RingStack, Ellipsoid or Tube writes n
// columns a ring ("seam = off"); every cap is a fan over the end ring's own
// vertices ("weld_caps = on"). Without these a shell would have a ring more
// vertices than the game's, and each cap a ring of vertices of its own.
// The game's v along a seamed shell is the distance along its profile; here
// v is the row share, as for any loft (the atlas shades by u and v, and the
// parity measures do not read them).
//
// The old file was a port of the first Python athlete and carried the
// morphs tall, short, neck-long, neck-short, brow and pad_size, a head loft,
// sleeve hems, wrist tape and a glove: the game's bake has none of them now.
// The helmet's shell, rim, ear cups, ear holes, strap, mask clips, chin pad
// and bumper are part of the body here, as in the game; the facemask styles,
// gloves, tape, cleat collars and the rest are gear the scene fixes on
// per player, and are not here.

asset athlete {
  title = "Athlete"
  root = body
  length = yd                // output is metres; see spec 4.2 and open question 6
  angle = deg
  up = y
  forward = -z               // the player faces -z
  idle = bind                // the nodes hold the bind pose, as the game's bake writes them (bind.gw)
  generator = "Federation Athletics character workshop"
  mesh_name = "Football uniform"
  // Plain nodes above the skeleton, outermost first. The game samples clips on
  // them as lookup tables for field position and heading (see the field clips).
  wrappers = ["field lateral", "field depth", "stance height", "body heading"]
  use_clips { of = football }
  use_clips { of = solved }
  use_clips { of = bindpose }
}

meta {
  author = "M31 Labs"
  license = "CC0-1.0"
}

// The helmet is a project asset. The path is relative to this file and stays
// inside the project root (examples/greenware.mod).
import "../helmet/helmet.gw" as helmet

// The game's body clips (ready, stance, run, ... kick), ported from pose.go, are a clip library.
import "clips/football.gw" as football
import "clips/solved.gw" as solved
import "bind.gw" as bindpose

// ---- Parameters ---------------------------------------------------------
// Runtime parameters become morph weights
// that the game sets per player. Bake parameters pick colours per output.

// The names follow the game's customisation model (athletelook): species Vael
// and Brannoc, and the seven build targets. The morphs below say which
// parameter drives which target.
param build : ratio = 0.35 in 0..1 runtime { doc = "0 a kicker's frame, 1 a lineman's (athletelook's mass)" }
param pads : ratio = 0.5 in 0..1 runtime { doc = "Shoulder pad size" }
param belly : ratio = 0 in 0..1 runtime { doc = "For heavy linemen" }
param species : enum(human, vael, brannoc) = human runtime

param jersey_color : color = #165348
param trim_color : color = #e1ae4f
param pants_color : color = #e9dbaf
param sock_color : color = #e7dcc1
param skin_tone : color = #916747

// ---- Skeleton -------------------------------------------------------------
// "at" is the joint's bind position in model space, as in the game's
// skeleton() (s.Add(name, parent, bind)); the compiler writes parent-relative translations.
// Joints have identity bind orientation (no "orient"), as in the game.
// Limits are swing and twist (spec 3.15): every bone here lies along Y, so
// twist is about Y and the swing ranges are about X and Z. The numbers are
// the game's Euler bands (audit.go), which agree with swing and twist for
// bones along Y at moderate angles; milestone M4 re-derives them. The mirror
// reflects the ranges for the right side.

skeleton body {
  // The game's joint order: both left limbs, then both right limbs.
  joint_order = [pelvis, chest, head, arml, elbowl, handl, legl, kneel, anklel,
                 armr, elbowr, handr, legr, kneer, ankler]
  // No root_scale: the game sets each player stature as a uniform scale on the whole model (athletelook), so the
  // clips need no height parameter and no tall or short target.

  joint pelvis {
    at = (0, 1, 0)
    socket towel { kind = towel at = (0.09, 1.04, -0.14) }

    joint chest {
      at = (0, 1.12, 0)
      swing_x = -70..30
      twist = -40..40
      swing_z = -35..35

      joint head {
        at = (0, 1.7, -0.012)
        swing_x = -60..70
        twist = -80..80
        swing_z = -40..40
        socket head_gear { kind = helmet at = (0, 1.7, -0.012) }
        socket crest { kind = crest at = (0, 1.93, -0.02) }   // a Vael crest runs through the helmet's channel
      }

      mirror {
        plane = x
        joint (arml, armr) {
          at = (0.284, 1.59, 0)
          swing_x = -60..170      // the game's 180, kept below the swing's 180° singularity
          twist = -90..90
          swing_z = -30..170
          joint (elbowl, elbowr) {
            at = (0.336, 1.275, -0.014)
            swing_x = -5..150
            twist = -80..80
            swing_z = -22..22       // widened from -20..20: the game's clips reach 20.9 degrees (swing and twist, not the game's Euler bands)
            joint (handl, handr) {
              at = (0.344, 1.034, -0.024)
              swing_x = -70..80
              twist = -30..30
              swing_z = -40..40
              socket (ball_l, ball_r) { kind = ball at = (0.344, 0.97, -0.07) }
              socket (hand_gear_l, hand_gear_r) { kind = hand at = (0.344, 0.987, -0.026) }   // species hands and gloves
            }
          }
        }
      }
    }

    mirror {
      plane = x
      joint (legl, legr) {
        at = (0.148, 1.015, 0.002)
        swing_x = -30..125
        twist = -40..40
        swing_z = -34..45       // widened from -30..45: the game's crossover reaches 32.4 degrees across the body
        joint (kneel, kneer) {
          at = (0.146, 0.57, -0.016)
          swing_x = -150..5
          twist = -15..15
          swing_z = -8..8
          joint (anklel, ankler) {
            at = (0.145, 0.035, -0.062)
            swing_x = -50..40       // widened from 35 and 20: the game's lateral footwork reaches 38.2 degrees up and 24.2 of twist
            twist = -25..25
            swing_z = -25..25
          }
        }
      }
    }
  }
}

// ---- Looks ----------------------------------------------------------------
// The atlas is 5 x 5 cells of 100 pixels, inset 7 % against mip bleed.
// Painters are the old Python port's atlas() shading, per cell. u and v run 0..1 over
// the inset area of a cell; px and py are the texel's column and row in the
// cell. Colours are in the stored sRGB encoding (0..1), so the Python's 8-bit
// grain of 1.2 becomes 1.2 / 255, as does its woven "textile" pattern.

painter cloth(base: color, folds: switch = off, skin: switch = off, dark: switch = off) {
  let turn = 360deg * u
  let wrap = 0.62 + 0.38 * (0.5 + 0.5 * cos(turn + 0.27rad))
  let shade = 0.89 + 0.10 * cos(2 * turn)
  let f = (0.65 + 0.35 * wrap) * (0.69 + 0.31 * sin(0.22rad + 2.35rad * v)) * shade
  let fold = if folds then 0.06 * sin(36rad * v + 2.9rad * cos(turn)) * (0.45 + 0.55 * pow(cos(180deg * v), 2)) else 0
  let pore = if skin then 0.045 * cos(3 * turn + 0.31rad) * sin(180deg * v) else 0
  let k = (f + fold + pore) * (if dark then 0.83 else 1)
  let textile = 0.8 * (if mod(px, 3) == 0 then 1 else 0) + 0.65 * (if mod(py, 4) == 1 then 1 else 0)
  color = base * k + (grain(1.2) - textile) / 255
}

painter sheen(base: color) {
  let turn = 360deg * u
  let wrap = 0.62 + 0.38 * (0.5 + 0.5 * cos(turn + 0.27rad))
  let k = 0.72 + 0.20 * wrap + 0.14 * sin(1.6rad * v) + 0.16 * pow(max(0, cos(turn + 0.9rad)), 8)
  let textile = 0.8 * (if mod(px, 3) == 0 then 1 else 0) + 0.65 * (if mod(py, 4) == 1 then 1 else 0)
  color = base * k + (grain(1.2) - textile) / 255
}

painter flat(base: color) {
  let wrap = 0.62 + 0.38 * (0.5 + 0.5 * cos(360deg * u + 0.27rad))
  let textile = 0.8 * (if mod(px, 3) == 0 then 1 else 0) + 0.65 * (if mod(py, 4) == 1 then 1 else 0)
  color = base * (0.88 + 0.12 * wrap) + (grain(1.2) - textile) / 255
}

texture kit = atlas {
  // The game's atlas (cmd/bakeathletes layout.go): 1024 texels square, a rectangle for each piece that carries a
  // design (the jersey, the sleeves, the helmet, the pants, the socks, the arms, the face) and 64 texel solid
  // cells along the bottom, each with a margin of 6 texels (8 on a solid cell). A shape's (u, v) spans its
  // rectangle inside the margin; the image itself is 512 x 512. The numbers are the game's cell numbers.
  size = 1024px
  texels = 512px   // the image is baked at half the layout's size: the rectangles are in layout units
  seed = 55
  cell torso { index = 0  x = 0 y = 0 w = 512 h = 512 margin = 6  paint = cloth(jersey_color, folds = on) }
  cell sleeve_r { index = 1  x = 512 y = 0 w = 256 h = 256 margin = 6  paint = cloth(jersey_color) }
  cell shell { index = 2  x = 512 y = 256 w = 512 h = 256 margin = 6  paint = sheen(jersey_color) }
  cell hips { index = 3  x = 0 y = 512 w = 256 h = 256 margin = 6  paint = cloth(pants_color, folds = on) }
  cell thigh { index = 4  x = 256 y = 512 w = 256 h = 256 margin = 6  paint = cloth(pants_color, folds = on) }
  cell thigh_r { index = 5  x = 512 y = 512 w = 256 h = 256 margin = 6  paint = cloth(pants_color, folds = on) }
  cell socks { index = 6  x = 768 y = 512 w = 128 h = 256 margin = 6  paint = cloth(sock_color) }
  cell skin { index = 7  x = 0 y = 768 w = 64 h = 64 margin = 8  paint = cloth(skin_tone, skin = on) }
  cell mask { index = 8  x = 64 y = 768 w = 64 h = 64 margin = 8  paint = sheen(#48545a) }
  cell gear { index = 9  x = 128 y = 768 w = 64 h = 64 margin = 8  paint = cloth(#242b30, dark = on) }
  cell mouth { index = 11  x = 256 y = 768 w = 64 h = 64 margin = 8  paint = flat(#713d32) }
  cell ear { index = 12  x = 320 y = 768 w = 64 h = 64 margin = 8  paint = flat(#242b30) }
  cell white { index = 13  x = 384 y = 768 w = 64 h = 64 margin = 8  paint = cloth(#fbefd4) }
  cell collar { index = 14  x = 448 y = 768 w = 64 h = 64 margin = 8  paint = sheen(trim_color) }
  cell pants { index = 15  x = 512 y = 768 w = 64 h = 64 margin = 8  paint = cloth(pants_color, folds = on) }
  cell cleat { index = 17  x = 640 y = 768 w = 64 h = 64 margin = 8  paint = cloth(#242b30, dark = on) }
  cell rubber { index = 18  x = 704 y = 768 w = 64 h = 64 margin = 8  paint = cloth(#242b30, dark = on) }
  cell knee { index = 19  x = 768 y = 768 w = 64 h = 64 margin = 8  paint = sheen(trim_color) }
  cell belt { index = 20  x = 832 y = 768 w = 64 h = 64 margin = 8  paint = cloth(#242b30, dark = on) }
  cell sleeve { index = 21  x = 768 y = 0 w = 256 h = 256 margin = 6  paint = cloth(jersey_color) }
  cell upperarm { index = 22  x = 0 y = 832 w = 256 h = 96 margin = 6  paint = cloth(skin_tone, skin = on) }
  cell forearm { index = 23  x = 0 y = 928 w = 256 h = 96 margin = 6  paint = cloth(skin_tone, skin = on) }
  cell face { index = 24  x = 256 y = 832 w = 128 h = 96 margin = 6  paint = cloth(skin_tone, skin = on) }
  encode = png
}

material kit_cloth = pbr {
  name = "Original equipment atlas"
  base_texture = kit
  roughness = 0.67
  metallic = 0.04
  double_sided = on
  filter = trilinear
  wrap = clamp
}

// ---- Body -------------------------------------------------------------------
// A loft is the game's RingStack or SeamStack: rows of (x, y, z, rx, rz) from bottom to top,
// "segments" vertices per ring, both ends closed by fans. An ellipsoid is Ellipsoid(); a tube is Tube().
// "joint" binds a shape rigidly; the skin block blends it.

part body {
  material = kit_cloth

  // ---- Trunk. hips, torso and face carry a seam so a design runs once round; belt and collar are plain stacks. ----
  loft hips {
    normals = faces
    v_by = length
    joint = pelvis
    cell = hips
    segments = 32
    weld_caps = on
    ring (0, 0.86, 0.019, 0.138, 0.122)
    ring (0, 0.96, 0.018, 0.212, 0.145)
    ring (0, 1.045, 0.015, 0.224, 0.144)
    ring (0, 1.11, 0, 0.19, 0.121)
  }
  // The belt stands a few millimetres proud of the hips and the jersey's hem, with as many sides as the torso.
  loft belt {
    normals = faces
    joint = pelvis
    cell = belt
    segments = 32
    seam = off
    weld_caps = on
    ring (0, 1.066, 0.008, 0.219, 0.149)
    ring (0, 1.104, 0.005, 0.207, 0.142)
  }
  loft torso {
    normals = faces
    v_by = length
    joint = chest
    cell = torso
    segments = 32
    weld_caps = on
    ring (0, 1.078, 0.002, 0.191, 0.13)
    ring (0, 1.12, 0.008, 0.204, 0.138)
    ring (0, 1.153, 0.013, 0.201, 0.144)
    ring (0, 1.179, 0.012, 0.21, 0.143)
    ring (0, 1.257, 0.008, 0.202, 0.14)
    ring (0, 1.352, -0.005, 0.235, 0.163)
    ring (0, 1.447, -0.015, 0.275, 0.192)
    ring (0, 1.503, -0.013, 0.294, 0.193)
    ring (0, 1.569, 0.008, 0.297, 0.166)
    ring (0, 1.615, 0.019, 0.258, 0.142)
    ring (0, 1.668, 0.016, 0.112, 0.105)
  }
  loft collar {
    normals = faces
    joint = chest
    cell = collar
    segments = 18
    seam = off
    weld_caps = on
    ring (0, 1.622, -0.006, 0.14, 0.108)
    ring (0, 1.657, -0.01, 0.135, 0.112)
    ring (0, 1.678, -0.006, 0.108, 0.098)
  }
  // A football neck: thick at the base where the trapezius meets the pads, narrowing under the jaw.
  loft neck {
    normals = faces
    joint = head
    cell = skin
    segments = 14
    seam = off
    weld_caps = on
    ring (0, 1.62, 0.006, 0.104, 0.09)
    ring (0, 1.69, -0.006, 0.088, 0.086)
    ring (0, 1.755, -0.014, 0.079, 0.084)
  }
  // The face has a cell of its own, so it takes the shade the helmet's shell casts over the brow and down the sides.
  loft face {
    normals = faces
    v_by = length
    joint = head
    cell = face
    segments = 18
    weld_caps = on
    ring (0, 1.695, -0.022, 0.059, 0.069)
    ring (0, 1.718, -0.047, 0.082, 0.097)
    ring (0, 1.759, -0.044, 0.103, 0.115)
    ring (0, 1.811, -0.044, 0.112, 0.12)
    ring (0, 1.867, -0.036, 0.114, 0.11)
    ring (0, 1.923, -0.024, 0.091, 0.09)
  }
  ellipsoid nose { normals = faces joint = head cell = skin centre = (0, 1.791, -0.161) radii = (0.027, 0.037, 0.03) segments = 12 rings = 8 seam = off weld_caps = on }
  ellipsoid mouthguard { normals = faces joint = head cell = mouth centre = (0, 1.747, -0.153) radii = (0.05, 0.009, 0.008) segments = 12 rings = 8 seam = off weld_caps = on }
  // The face's planes under the cage: a brow over the eyes and a chin, and a cheekbone either side.
  ellipsoid brow { normals = faces joint = head cell = skin centre = (0, 1.842, -0.149) radii = (0.072, 0.013, 0.02) segments = 12 rings = 8 seam = off weld_caps = on }
  ellipsoid chin { normals = faces joint = head cell = skin centre = (0, 1.722, -0.131) radii = (0.038, 0.024, 0.026) segments = 12 rings = 8 seam = off weld_caps = on }
  ellipsoid chinpad { normals = faces joint = head cell = white centre = (0, 1.71, -0.132) radii = (0.058, 0.026, 0.025) segments = 14 rings = 7 seam = off weld_caps = on }
  ellipsoid bumper { normals = faces joint = head cell = rubber centre = (0, 1.786, 0.136) radii = (0.07, 0.012, 0.008) segments = 12 rings = 5 seam = off weld_caps = on }

  // ---- Helmet shell: the control levels run through a Catmull-Rom curve (athletebody.HelmetLevels, 4 steps between levels), so the crown is a smooth dome. Open at the crown. ----
  loft helmet {
    normals = faces
    v_by = length
    joint = head
    cell = shell
    segments = 48
    caps = off
    columns = (y, rx, rz, rise)
    vertex = (rx * sin(a), y + rise * pow(max(0, -cos(a)), 3), rz * cos(a) - 0.012)
    ring (1.715, 0.119, 0.121, 0.175)
    ring (1.720265625, 0.1240078125, 0.127171875, 0.17090625)
    ring (1.7275, 0.1313125, 0.136125, 0.165375)
    ring (1.737734375, 0.1387109375, 0.145515625, 0.15690625)
    ring (1.752, 0.144, 0.153, 0.144)
    ring (1.772296875, 0.14653125, 0.1583515625, 0.1238984375)
    ring (1.7975, 0.1475, 0.1626875, 0.0981875)
    ring (1.823953125, 0.14746875, 0.1656796875, 0.0718828125)
    ring (1.848, 0.147, 0.167, 0.05)
    ring (1.8693359375, 0.146609375, 0.16659375, 0.033234375)
    ring (1.8896875, 0.145875, 0.164625, 0.019125)
    ring (1.9084453125, 0.143953125, 0.16109375, 0.007953125)
    ring (1.925, 0.14, 0.156, 0)
    ring (1.9390859375, 0.133640625, 0.1491796875, 0)
    ring (1.9510625, 0.125375, 0.1406875, 0)
    ring (1.9612578125, 0.115671875, 0.1308515625, 0)
    ring (1.97, 0.105, 0.12, 0)
    ring (1.977015625, 0.09296875, 0.1080234375, 0)
    ring (1.98225, 0.0795, 0.0948125, 0)
    ring (1.986359375, 0.06553125, 0.0806953125, 0)
    ring (1.99, 0.052, 0.066, 0)
    ring (1.993234375, 0.0379140625, 0.049, 0)
    ring (1.99575, 0.0231875, 0.030125, 0)
    ring (1.997640625, 0.0101171875, 0.0129375, 0)
    ring (1.999, 0.001, 0.001, 0)
  }
  // A rubber bead finishes the rim: 49 points round level 0 (the last repeats the first), pushed out 2.5 mm.
  tube helmetrim {
    diagonal = flip
    normals = faces
    v_by = point
    joint = head
    cell = rubber
    radius = 0.0055
    segments = 8
    seam = off
    sample a in 0deg..360deg by 49 -> point (
      0.119 * sin(a) * (1 + 0.0025 / sqrt(pow(0.119 * sin(a), 2) + pow(0.121 * cos(a), 2))),
      1.715 + 0.175 * pow(max(0, -cos(a)), 3),
      0.121 * cos(a) * (1 + 0.0025 / sqrt(pow(0.119 * sin(a), 2) + pow(0.121 * cos(a), 2))) - 0.012)
  }

  mirror {
    plane = x
    reflect = inputs   // each right-hand shape is built again from reflected inputs, as the game builds its right side

    // The helmet's cheek pads, inside the shell either side of the jaw.
    ellipsoid (cheekpad_l, cheekpad_r) { normals = faces joint = head cell = gear centre = (0.122, 1.762, -0.052) radii = (0.016, 0.05, 0.06) segments = 12 rings = 8 seam = off weld_caps = on }
    ellipsoid (eye_l, eye_r) { normals = faces joint = head cell = white centre = (0.048, 1.824, -0.162) radii = (0.022, 0.006, 0.004) segments = 12 rings = 8 seam = off weld_caps = on }
    ellipsoid (pupil_l, pupil_r) { normals = faces joint = head cell = gear centre = (0.046, 1.824, -0.166) radii = (0.008, 0.006, 0.003) segments = 12 rings = 8 seam = off weld_caps = on }
    ellipsoid (cheek_l, cheek_r) { normals = faces joint = head cell = skin centre = (0.06, 1.786, -0.128) radii = (0.03, 0.02, 0.02) segments = 12 rings = 8 seam = off weld_caps = on }
    // The ear cup is padding inside the shell; a small vent behind it; the chin strap runs from the shell's jaw to the cup.
    ellipsoid (earcup_l, earcup_r) { normals = faces joint = head cell = gear centre = (0.127, 1.805, 0.014) radii = (0.013, 0.04, 0.03) segments = 12 rings = 8 seam = off weld_caps = on }
    ellipsoid (earhole_l, earhole_r) { normals = faces joint = head cell = ear centre = (0.145, 1.8, 0.03) radii = (0.0035, 0.0055, 0.006) segments = 12 rings = 8 seam = off weld_caps = on }
    tube (chinstrap_l, chinstrap_r) {
      diagonal = flip
      normals = faces
      v_by = point
      joint = head
      cell = white
      radius = 0.0062
      segments = 8
      seam = off
      point (0.131, 1.79, 0.004)
      point (0.126, 1.755, -0.04)
      point (0.113, 1.726, -0.088)
      point (0.057, 1.704, -0.13)
    }
    // The cage's clips where the rails meet the shell: two a side, at 1.868 and 1.805.
    array (maskclip_l, maskclip_r) {
      mode = linear
      count = 2
      step = (0, -0.063, 0)
      ellipsoid { normals = faces joint = head cell = mask centre = (0.145, 1.868, -0.032) radii = (0.007, 0.014, 0.012) segments = 8 rings = 5 seam = off weld_caps = on }
    }

    // The sleeve cap over the deltoid is squared: broad almost to its top, then a short flat plate.
    loft (shoulderpad_l, shoulderpad_r) {
      mirror_cell = sleeve_r
      normals = faces
      v_by = length
      joint = arml
      cell = sleeve
      segments = 18
      weld_caps = on
      ring (0.314, 1.403, 0.004, 0.08, 0.092)
      ring (0.318, 1.435, 0.002, 0.099, 0.103)
      ring (0.301, 1.518, 0.001, 0.128, 0.124)
      ring (0.284, 1.585, 0.005, 0.126, 0.126)
      ring (0.27, 1.622, 0.007, 0.121, 0.121)
      ring (0.262, 1.64, 0.006, 0.099, 0.103)
      ring (0.256, 1.648, 0.006, 0.06, 0.066)
      ring (0.25, 1.651, 0.006, 0.014, 0.026)
    }
    // The bare arms have cells of their own, so the material knows where a texel sits on the arm.
    loft (upperarm_l, upperarm_r) {
      normals = faces
      v_by = length
      joint = arml
      cell = upperarm
      segments = 14
      weld_caps = on
      ring (0.336, 1.265, -0.01, 0.054, 0.059)
      ring (0.335, 1.306, -0.01, 0.071, 0.07)
      ring (0.33, 1.363, -0.016, 0.079, 0.086)
      ring (0.315, 1.414, -0.001, 0.08, 0.083)
      ring (0.314, 1.447, 0.005, 0.075, 0.08)
    }
    loft (forearm_l, forearm_r) {
      normals = faces
      v_by = length
      joint = elbowl
      cell = forearm
      segments = 14
      weld_caps = on
      ring (0.347, 1.047, -0.028, 0.04, 0.034)
      ring (0.348, 1.123, -0.024, 0.05, 0.052)
      ring (0.346, 1.213, -0.014, 0.073, 0.068)
      ring (0.339, 1.275, -0.012, 0.063, 0.064)
      ring (0.334, 1.299, -0.012, 0.045, 0.047)
    }
    // The bare hand: palm and back, a thumb apart on the inside, four fingers. The game staggers the fingers in height
    // (0.939, 0.934, 0.939, 0.944): the array names its "index" n and each copy is resolved with its own n.
    ellipsoid (hand_l, hand_r) { normals = faces joint = handl cell = skin centre = (0.343, 0.987, -0.026) radii = (0.048, 0.079, 0.033) segments = 12 rings = 8 seam = off weld_caps = on }
    ellipsoid (palm_l, palm_r) { normals = faces joint = handl cell = skin centre = (0.342, 1.003, -0.05) radii = (0.039, 0.046, 0.012) segments = 12 rings = 8 seam = off weld_caps = on }
    ellipsoid (thumb_l, thumb_r) { normals = faces joint = handl cell = skin centre = (0.3, 0.985, -0.045) radii = (0.013, 0.032, 0.016) segments = 7 rings = 5 seam = off weld_caps = on }
    array (finger_l, finger_r) {
      mode = linear
      count = 4
      step = (0.018, 0, 0)
      index = n
      ellipsoid { normals = faces joint = handl cell = skin centre = (0.311, 0.934 + abs(n - 1) * 0.005, -0.025) radii = (0.010, 0.034, 0.015) segments = 7 rings = 5 seam = off weld_caps = on }
    }

    // The thigh carries the pant stripe down its outside; the thigh pad rides its surface.
    loft (thigh_l, thigh_r) {
      mirror_cell = thigh_r
      normals = faces
      v_by = length
      joint = legl
      cell = thigh
      segments = 28
      weld_caps = on
      ring (0.145, 0.555, -0.008, 0.08, 0.085)
      ring (0.146, 0.62, -0.024, 0.094, 0.1)
      ring (0.157, 0.699, -0.021, 0.111, 0.124)
      ring (0.153, 0.807, -0.014, 0.128, 0.15)
      ring (0.144, 0.912, 0.007, 0.136, 0.148)
      ring (0.136, 1.006, 0.014, 0.121, 0.129)
      ring (0.129, 1.057, 0.008, 0.097, 0.106)
    }
    ellipsoid (thighpad_l, thighpad_r) { normals = faces joint = legl cell = pants centre = (0.161, 0.662, -0.089) radii = (0.079, 0.105, 0.048) segments = 12 rings = 8 seam = off weld_caps = on }
    loft (shin_l, shin_r) {
      normals = faces
      v_by = length
      joint = kneel
      cell = socks
      segments = 16
      weld_caps = on
      ring (0.145, 0.161, 0.014, 0.048, 0.053)
      ring (0.146, 0.28, 0.027, 0.058, 0.064)
      ring (0.147, 0.388, 0.026, 0.08, 0.089)
      ring (0.147, 0.472, 0.017, 0.085, 0.087)
      ring (0.145, 0.524, -0.006, 0.076, 0.073)
      ring (0.145, 0.573, -0.012, 0.074, 0.074)
    }
    // The sock's knee band and pad stand clear of the shin, with the sock's sides, so the shin never shows through their edges.
    loft (kneeband_l, kneeband_r) {
      normals = faces
      joint = kneel
      cell = white
      segments = 16
      seam = off
      weld_caps = on
      ring (0.145, 0.49, 0.01, 0.087, 0.089)
      ring (0.145, 0.515, 0, 0.083, 0.082)
    }
    loft (kneepad_l, kneepad_r) {
      normals = faces
      joint = kneel
      cell = knee
      segments = 16
      seam = off
      weld_caps = on
      ring (0.145, 0.449, 0.02, 0.091, 0.093)
      ring (0.145, 0.466, 0.019, 0.09, 0.093)
    }
    loft (cleat_l, cleat_r) {
      normals = faces
      joint = anklel
      cell = cleat
      segments = 16
      seam = off
      weld_caps = on
      ring (0.145, 0.045, -0.055, 0.075, 0.164)
      ring (0.145, 0.078, -0.054, 0.074, 0.161)
      ring (0.145, 0.115, -0.033, 0.066, 0.132)
      ring (0.145, 0.157, 0.009, 0.055, 0.072)
      ring (0.145, 0.177, 0.009, 0.051, 0.065)
    }
    loft (sole_l, sole_r) {
      normals = faces
      joint = anklel
      cell = rubber
      segments = 14
      seam = off
      weld_caps = on
      ring (0.145, 0.035, -0.062, 0.073, 0.16)
      ring (0.145, 0.051, -0.062, 0.076, 0.165)
    }
  }

  // The laces are written out for each foot, not mirrored: the game builds a lace from the foot's outer point to its
  // inner one (s * 0.145 - 0.03 to s * 0.145 + 0.03), so the right foot's tube runs the other way along x from the
  // left's. A mirror would reverse the point order and make every lace vertex a different vertex.
  array lace_l {
    mode = linear
    count = 3
    step = (0, 0, 0.03)
    tube {
      diagonal = flip
      normals = faces
      v_by = point
      joint = anklel
      cell = white
      radius = 0.0035
      segments = 4
      seam = off
      point (0.115, 0.106, -0.1)
      point (0.175, 0.11, -0.109)
    }
  }
  array lace_r {
    mode = linear
    count = 3
    step = (0, 0, 0.03)
    tube {
      diagonal = flip
      normals = faces
      v_by = point
      joint = ankler
      cell = white
      radius = 0.0035
      segments = 4
      seam = off
      point (-0.175, 0.106, -0.1)
      point (-0.115, 0.11, -0.109)
    }
  }
}

// ---- Skin -------------------------------------------------------------------
// Every shape starts rigid on its "joint". These steps then run in order.

skin {
  max_influences = 2

  // the game's proportion(): a person's arm is about 33 % of stature, with the
  // upper arm about 1.25 times the forearm. lengthen moves the child joint and
  // stretches the vertices bound past "anchor" (a share of the bone).
  mirror {
    plane = x
    lengthen { joint = arml to = 0.355 anchor = 0.5 rigid = [shoulderpad_l] }
    lengthen { joint = elbowl to = 0.285 anchor = 0 }
  }

  // the game's blend(): weights ease from parent to child across "width" either
  // side of "centre", along "axis". joint(name) is a joint's bind position
  // after the lengthen steps.
  blend waist { parent = pelvis child = chest centre = joint(chest) axis = (0, 1, 0) width = 0.07 }
  blend neck { parent = chest child = head centre = (0, 1.69, -0.006) axis = (0, 1, 0) width = 0.05 }
  mirror {
    plane = x
    blend (hip_l, hip_r) {
      parent = pelvis
      child = legl
      centre = joint(legl) + (0, -0.045, 0)
      axis = (0, -1, 0)
      width = 0.08
      fade_x = 0..0.12       // fades in from the midline toward this side
    }
    blend (knee_l, knee_r) { parent = legl child = kneel centre = joint(kneel) axis = (0, -1, 0) width = 0.11 }
    blend (shin_l, shin_r) { parent = kneel child = anklel centre = (0.145, 0.17, -0.03) axis = (0, -1, 0) width = 0.045 }
    blend (shoulder_l, shoulder_r) {
      parent = chest
      child = arml
      centre = joint(arml) + (0, -0.02, 0)
      axis = (0, -1, 0)
      width = 0.09
      only = [shoulderpad_l]
    }
    blend (elbow_l, elbow_r) { parent = arml child = elbowl centre = joint(elbowl) axis = (0, -1, 0) width = 0.08 }
    blend (wrist_l, wrist_r) { parent = elbowl child = handl centre = joint(handl) + (0, 0.02, 0) axis = (0, -1, 0) width = 0.04 }
  }
}

// ---- Morph targets ------------------------------------------------------------
// The game's seven body-build targets (athletebody.Morphs), at weight 1. Each
// widens a part about the centre of each of its rings: a "girth" operation gives the
// fractional change of the offset from the ring's centre along x (side) and along z
// (front, back), as a function of the position's height y in yards. The shapes are the
// game's athletebody.GirthAt: "ramp" is smoothstep, "bump" a raised cosine, and a
// limb's envelope is sin squared of its bind span, so a build fills the belly of a
// limb and never its joint. Heights are those of the finished bind mesh, as in the
// game, where the targets are built after the arms are lengthened. The span numbers
// of the limbs are the pre-lengthen bind heights, as the game's.
//
// The thigh pad is not a ring stack: the game moves it as a point of the thigh's surface
// at the pad's height would move, so each target gives it one "offset" (the values are
// athletebody.Displace of the pad's centre, evaluated once).
//
// The runtime parameters drive the weights as the old file did: build the mass, the
// waist and seat and the leg power (their game ranges are -0.6..1, -0.8..0.95 and
// -0.28..1), pads the pad size (-0.8..0.75), belly the belly, and species the other two.

morph mass {
  weight = build * 1.6 - 0.6
  girth {
    parts = [torso, belt, hips]
    side = 0.11 * smoothstep(1.0, 1.12, y) + 0.08 * (if abs(y - 0.95) < 0.14 then 0.5 + 0.5 * cos(180deg * abs(y - 0.95) / 0.14) else 0)
    front = 0.14 * smoothstep(1.0, 1.12, y) + 0.04 * (if abs(y - 0.95) < 0.14 then 0.5 + 0.5 * cos(180deg * abs(y - 0.95) / 0.14) else 0)
    back = 0.12 * smoothstep(1.0, 1.12, y) + 0.1 * (if abs(y - 0.95) < 0.14 then 0.5 + 0.5 * cos(180deg * abs(y - 0.95) / 0.14) else 0)
  }
  girth {
    parts = [neck, collar]
    side = 0.08 * (1 - smoothstep(1.64, 1.7, y))
    front = 0.08 * (1 - smoothstep(1.64, 1.7, y))
    back = 0.08 * (1 - smoothstep(1.64, 1.7, y))
  }
  mirror {
    plane = x
    girth {
      parts = [upperarm_l]
      side = 0.045 * pow(sin(180deg * clamp((y - 1.265) / (1.447 - 1.265), 0, 1)), 2)
      front = 0.045 * pow(sin(180deg * clamp((y - 1.265) / (1.447 - 1.265), 0, 1)), 2)
      back = 0.045 * pow(sin(180deg * clamp((y - 1.265) / (1.447 - 1.265), 0, 1)), 2)
    }
    girth {
      parts = [forearm_l]
      side = 0.025 * pow(sin(180deg * clamp((y - 1.047) / (1.299 - 1.047), 0, 1)), 2)
      front = 0.025 * pow(sin(180deg * clamp((y - 1.047) / (1.299 - 1.047), 0, 1)), 2)
      back = 0.025 * pow(sin(180deg * clamp((y - 1.047) / (1.299 - 1.047), 0, 1)), 2)
    }
    girth {
      parts = [thigh_l]
      side = 0.06 * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
      front = 0.06 * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
      back = 0.06 * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
    }
    offset { parts = [thighpad_l] by = (0.000211549, 0, -0.001539366) }
  }
}

morph belly {
  weight = belly
  girth {
    parts = [torso, belt, hips]
    side = 0.06 * (if abs(y - 1.17) < 0.2 then 0.5 + 0.5 * cos(180deg * abs(y - 1.17) / 0.2) else 0)
    front = 0.26 * (if abs(y - 1.17) < 0.2 then 0.5 + 0.5 * cos(180deg * abs(y - 1.17) / 0.2) else 0)
    back = 0.02 * (if abs(y - 1.17) < 0.2 then 0.5 + 0.5 * cos(180deg * abs(y - 1.17) / 0.2) else 0)
  }
}

morph pads {
  weight = pads * 1.55 - 0.8
  girth {
    parts = [torso, belt, hips]
    side = 0.085 * smoothstep(1.43, 1.55, y)
    front = 0.045 * smoothstep(1.43, 1.55, y)
    back = 0.06 * smoothstep(1.43, 1.55, y)
  }
  mirror {
    plane = x
    girth {
      parts = [shoulderpad_l]
      side = 0.12
      front = 0.12
      back = 0.12
    }
  }
}

morph chest_deep {
  name = "chest-deep"
  weight = if species == brannoc then 1 else 0
  girth {
    parts = [torso, belt, hips]
    side = 0.03 * (if abs(y - 1.4) < 0.22 then 0.5 + 0.5 * cos(180deg * abs(y - 1.4) / 0.22) else 0)
    front = 0.16 * (if abs(y - 1.4) < 0.22 then 0.5 + 0.5 * cos(180deg * abs(y - 1.4) / 0.22) else 0)
    back = 0.1 * (if abs(y - 1.4) < 0.22 then 0.5 + 0.5 * cos(180deg * abs(y - 1.4) / 0.22) else 0)
  }
}

morph limb_lean {
  name = "limb-lean"
  weight = if species == vael then 1 else 0
  mirror {
    plane = x
    girth {
      parts = [upperarm_l]
      side = -0.12 * pow(sin(180deg * clamp((y - 1.265) / (1.447 - 1.265), 0, 1)), 2)
      front = -0.12 * pow(sin(180deg * clamp((y - 1.265) / (1.447 - 1.265), 0, 1)), 2)
      back = -0.12 * pow(sin(180deg * clamp((y - 1.265) / (1.447 - 1.265), 0, 1)), 2)
    }
    girth {
      parts = [forearm_l]
      side = -0.1 * pow(sin(180deg * clamp((y - 1.047) / (1.299 - 1.047), 0, 1)), 2)
      front = -0.1 * pow(sin(180deg * clamp((y - 1.047) / (1.299 - 1.047), 0, 1)), 2)
      back = -0.1 * pow(sin(180deg * clamp((y - 1.047) / (1.299 - 1.047), 0, 1)), 2)
    }
    girth {
      parts = [thigh_l]
      side = -0.1 * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
      front = -0.1 * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
      back = -0.1 * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
    }
    girth {
      parts = [shin_l, kneeband_l, kneepad_l]
      side = -0.08 * pow(sin(180deg * clamp((y - 0.161) / (0.573 - 0.161), 0, 1)), 2)
      front = -0.08 * pow(sin(180deg * clamp((y - 0.161) / (0.573 - 0.161), 0, 1)), 2)
      back = -0.08 * pow(sin(180deg * clamp((y - 0.161) / (0.573 - 0.161), 0, 1)), 2)
    }
    offset { parts = [thighpad_l] by = (-0.000352582, 0, 0.002565610) }
  }
}

morph waist_seat {
  name = "waist-seat"
  weight = build * 1.75 - 0.8
  girth {
    parts = [torso, belt, hips]
    side = 0.095 * (if abs(y - 1.16) < 0.16 then 0.5 + 0.5 * cos(180deg * abs(y - 1.16) / 0.16) else 0) + 0.08 * (if abs(y - 0.95) < 0.14 then 0.5 + 0.5 * cos(180deg * abs(y - 0.95) / 0.14) else 0)
    back = 0.06 * (if abs(y - 1.16) < 0.16 then 0.5 + 0.5 * cos(180deg * abs(y - 1.16) / 0.16) else 0) + 0.1 * (if abs(y - 0.95) < 0.14 then 0.5 + 0.5 * cos(180deg * abs(y - 0.95) / 0.14) else 0)
  }
}

morph leg_power {
  name = "leg-power"
  weight = build * 1.28 - 0.28
  mirror {
    plane = x
    girth {
      parts = [thigh_l]
      side = 0.15 * (if abs(y - 0.81) < 0.16 then 0.5 + 0.5 * cos(180deg * abs(y - 0.81) / 0.16) else 0) * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
      front = 0.14 * (if abs(y - 0.81) < 0.16 then 0.5 + 0.5 * cos(180deg * abs(y - 0.81) / 0.16) else 0) * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
      back = 0.09 * (if abs(y - 0.81) < 0.16 then 0.5 + 0.5 * cos(180deg * abs(y - 0.81) / 0.16) else 0) * pow(sin(180deg * clamp((y - 0.555) / (1.057 - 0.555), 0, 1)), 2)
    }
    girth {
      parts = [shin_l, kneeband_l, kneepad_l]
      back = 0.08 * (if abs(y - 0.39) < 0.1 then 0.5 + 0.5 * cos(180deg * abs(y - 0.39) / 0.1) else 0) * pow(sin(180deg * clamp((y - 0.161) / (0.573 - 0.161), 0, 1)), 2)
    }
    offset { parts = [thighpad_l] by = (0.000007306, 0, -0.000049622) }
  }
}

// ---- Gear ---------------------------------------------------------------------

// The helmet document's plug meets this figure's head_gear socket. With
// mode = runtime the game mounts helmet-classic.glb or helmet-aero.glb on the
// socket and sets its parameters per player; mode = bake merges the helmet
// into this mesh, rigid on the head joint. The body has its own helmet shell now (the game's), so this gear is the
// classic and aero helmets of examples/helmet, kept to exercise the mount.
mount headgear {
  asset = helmet
  socket = head_gear
  mode = runtime
  set {
    shell_style = classic    // picks helmet-classic.glb
    facemask = cage
  }
  // Mounted, the helmet is to keep 2 mm from the head in the bind pose and at every key of every clip. The
  // gear's shell has the game's control levels, as the body's own helmet shell has, so the two are the same
  // surface and the gap is 0 mm: `greenware build` with this line refuses the athlete with GW-MOUNT, and the
  // accept file measures the gap on the baked outputs.
  // fit { clearance = 2mm }
}

// ---- Clips --------------------------------------------------------------------
// A clip samples its pose at "keys" evenly spaced times from t = 0 to t = 1,
// both ends included, and writes LINEAR keys over "duration" (the game's
// linspace(0, 1, n) * duration). rot(x, y, z) is intrinsic X, then Y, then Z,
// in degrees here. root is the root joint's translation.
// Inside the mirror, "side" is 1 for the left copy and -1 for the right copy,
// and the right copy's rotations are reflected (Y and Z negated for these
// identity-oriented joints), so the game's q(upper, sg*3, sg*8) is
// written arml = rot(upper, 3, 8). A reference to arml in the right copy
// resolves to armr, its pair. Bare literals take degrees from the slot; a
// "let" carries its unit, so the thigh and shin angles are written in deg.

// The four lookup channels on the wrapper nodes. Their "times" are
// field coordinates, not seconds: the game samples field-x at time x + 64.
// "name" keeps the game's hyphenated animation names.
clip field_x {
  name = "field-x"
  node = "field lateral"
  key (0s, (-64, 0, 0))
  key (128s, (64, 0, 0))
}
clip field_z {
  name = "field-z"
  node = "field depth"
  key (0s, (0, 0, -144))
  key (192s, (0, 0, 48))
}
clip stance_height {
  name = "stance-height"
  node = "stance height"
  key (0s, (0, -1, 0))
  key (2s, (0, 1, 0))
}
clip heading {
  name = "heading"
  node = "body heading"
  sample h in -180deg..180deg by 33 -> key (seconds(radians(h + 180deg)), rot(0, h, 0))
}

// ---- Collision, checks, budgets ---------------------------------------------------

// One hit capsule, independent of gear, so every build and helmet is equally
// easy to hit.
collision {
  capsule hit {
    joint = pelvis
    from = (0, 0.12, 0)
    to = (0, 1.82, 0)
    radius = 0.22
  }
}

// Every check below runs at these runtime points, not only the defaults
// (spec 6.9): each body parameter at its extremes, every species, and both
// helmet shells on the mount, one at a time. The named case adds the
// combination most likely to clip, a Brannoc lineman under the aero shell.
check runtime {
  corners = [build, pads, belly]
  each = [species]
  gear = [helmet.classic, helmet.aero]
  // Already inside the full product (2^3 x 3 x 2 = 48 points); named so the
  // report lists it by name.
  case brannoc_lineman_aero {
    set { species = brannoc build = 1 belly = 1 }
    gear = helmet.aero
  }
}

// The deformation audit (spec section 6.6): every clip, every key, at every
// level of detail, with these pass marks.
check rig {
  // The game roots each clip with a closed form that is exact for ready and off for others (pose.go): catch
  // stands 28.3 mm high and the kick sinks its plant foot 55.8 mm, because it reuses ready's legs at a root
  // 6 cm lower. The band takes the game's clips as they are; athlete.accept.gw holds ready to -5..20 mm.
  ground = -60mm..40mm        // the lowest sole vertex at every key and runtime point
  waist = (pelvis, chest)
  legs = (legl, legr)
  waist_ratio = 0.95
  torn = 1%
  open = 2%
  bands = error
}

// The budget is MEASURED from the build's census, per output and level (decision
// 0018, H2; `greenware build --json` prints the census, with a row for every
// shape). The measured figures, level 0 of each output, against the game's Go
// bake at commit 3848013 (13,016 triangles, 6,836 vertices, the body only):
//
//   output  triangles  vertices  decoded images   file bytes
//   match     13,016     6,836     1,000,000 (1)   1,230,188
//   home      14,782     8,048     1,262,144 (3)   1,316,688
//   away      14,782     8,048     1,262,144 (3)   1,306,608
//
// home and away carry the old helmet gear baked in, which the body's own helmet
// now makes a second helmet: they are compatibility fixtures. Level 1 is smaller
// in every column. The old limits stay as refusal tests (compiler/athlete_test.go):
// the same asset under file_size = 1MiB on the baked files, or texture_bytes =
// 128KiB anywhere, is refused with GW-BUDGET.
budget {
  triangles = 14000          // measured 13,016
  bones = 15
  influences = 2
  texture_bytes = 1MiB       // match: one 512 x 512 RGBA image, 1,048,576 B decoded
  materials = 1
  draw_calls = 1              // the match file; the helmet gear is its own model
  draw_calls_worst = 1
  // The seven build targets, under the default of 8. Targets are stored sparse
  // (only the vertices a target moves).
  morphs = 7
  vertices = 7400            // measured 6,836
  file_size = 1344KiB        // measured 1,229,112 B: 89% of it, with 32 animations
}

// Re-tessellation, not decimation: every shape is parametric. Fewer segments
// per ring within 4 mm, interior loft rings dropped where the surface moves
// less than that. The skeleton, clips and sockets stay.
lod 1 {
  distance = 30m
  max_error = 4mm
  keep = [face, hand_l, hand_r]        // these keep their lod 0 segments
  drop = [lace_l, lace_r, pupil_l, pupil_r, brow, eye_l, eye_r, earhole_l, earhole_r]
}

// ---- Outputs ------------------------------------------------------------------------

// NOT IMPLEMENTED ON PURPOSE (table, kits_home, kits_away at the end of this
// file): the sample's school table and its split kit outputs. Plan 4.5 step 2
// says home/away and the split kit descriptors are pinned compatibility and
// codec fixtures and that they are never restored as game outputs: the game now
// draws one athlete.glb with one Selena uniform per player and requests no kit
// file. `table` and `for_each` are implemented (compiler/table_test.go builds a
// table-driven family of GLB files); the split `.gltf` writer (`buffer`,
// `image = jpeg(89)`) is not, because package gltf writes GLB only.
// athlete.glb: the match file. The helmet is mounted at run time on head_gear.
output match {
  file = "athlete.glb"
  mounts = runtime
}

// home.glb and away.glb: the old port's two files, for parity, helmet merged in
// with the mount's set values. The baked helmet adds its palette material.
output home {
  file = "home.glb"
  mounts = bake
  // The baked helmet adds its palette material, its two 256 x 128 images
  // (262,144 B decoded) and its triangles: 1,310,720 B decoded in all, and a
  // file 26,116 B over 1 MiB. Measured ceilings, per output (decision 0018).
  budget {
    materials = 2 draw_calls = 2 draw_calls_worst = 2
    triangles = 16000 texture_bytes = 1280KiB vertices = 8800 file_size = 1440KiB
  }
}
output away {
  file = "away.glb"
  mounts = bake
  budget {
    materials = 2 draw_calls = 2 draw_calls_worst = 2
    triangles = 16000 texture_bytes = 1280KiB vertices = 8800 file_size = 1440KiB
  }
  set {
    jersey_color = #f1f2ed
    trim_color = #aa3f28
    pants_color = #ab4834
    sock_color = #e5e8dd
  }
}

// kits/home-<main>.gltf and kits/away-<main>.gltf, left out (see above): one
// small glTF per school and side, each with its own atlas, all sharing
// kits/athlete.bin. The text of the sample is kept in testdata/syntax/athlete.gw.
