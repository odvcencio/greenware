(* Greenware edition 1 grammar. Generated by go generate ./lang from language/grammar/grammar.go. Do not edit.
   Quoted forms are literal terminals; /.../ forms are regular expressions.
   Brackets mean optional, braces mean zero-or-more, and parentheses group.
   Spaces, tabs, CR, LF, and // comments are ignored between tokens. Line breaks carry
   no meaning; one setting or row per line is the formatter's style, not a rule.
   Names that begin with an underscore are hidden: they build no node of their own.
   Expression precedence (larger levels bind more tightly):
     level 8 is postfix: call "(...)", index "[...]", member "."
     level 7 is prefix "-", "+", "!" (an axis value is written +z or -z)
     level 6 is left-associative for "*", "/"
     level 5 is left-associative for "+", "-"
     level 4 is non-associative for "==", "!=", "<", "<=", ">", ">="
     level 3 is left-associative for "&&"
     level 2 is left-associative for "||"
     level 1 is "if ... then ... else ..." (right-associative)
   ".." is not an operator. A range appears only where the grammar names one.
   Inside bodies the grammar is generic: settings, rows, sampled rows, blocks, "when",
   "let", "part" and waivers. Which fields, rows and blocks a kind accepts, and their
   types and units, come from the registry, not from the parser.
   Reserved words, which never name a field, row or block: greenware import when else
   let sample waive part if then. Every other keyword in this file is contextual: it is
   a keyword only where a rule below expects it. So "by" introduces a count in a sampled
   row and is an ordinary field name in "inflate { by = 14% }", and "runtime" is a
   parameter modifier after a param's default and an ordinary value in
   "mount { mode = runtime }". Top-level declaration keywords (asset, param, material,
   ...) are likewise ordinary names inside bodies.
   A qualified name is one token with no space inside it. A dotted form with spaces
   reads as member access. *)

source_file ::= [ edition_decl ] , { _declaration } ;
edition_decl ::= "greenware" , integer ;
_declaration ::= import_decl | asset_decl | param_decl | let_decl | table_decl | material_decl |
                 texture_decl | mesh_decl | view_decl | painter_decl | template_decl | part_decl |
                 plug_decl | mount_decl | skeleton_decl | skin_decl | morph_decl | clip_decl |
                 lod_decl | collision_decl | budget_decl | variant_decl | output_decl | meta_decl |
                 check_decl | accept_decl ;
import_decl ::= "import" , string , [ "as" , identifier ] ;
asset_decl ::= "asset" , identifier , body ;
meta_decl ::= "meta" , body ;
param_decl ::= "param" , identifier , ":" , param_type , "=" , _expression , [ "in" , range ] ,
               [ "runtime" ] , [ body ] ;
param_type ::= identifier , [ "(" , identifier , { "," , identifier } , ")" ] ;
let_decl ::= "let" , identifier , "=" , _expression ;
table_decl ::= "table" , identifier , "=" , identifier , body ;
material_decl ::= "material" , identifier , "=" , source_value ;
texture_decl ::= "texture" , identifier , "=" , source_value ;
mesh_decl ::= "mesh" , identifier , "=" , source_value ;
source_value ::= identifier , body ;
painter_decl ::= "painter" , identifier , "(" , [ typed_param , { "," , typed_param } ] , ")" , body ;
typed_param ::= identifier , ":" , param_type , [ "=" , _expression ] ;
part_decl ::= "part" , _declared_name , body ;
template_decl ::= "template" , identifier , "(" , [ typed_param , { "," , typed_param } ] , ")" ,
                  body ;
plug_decl ::= "plug" , identifier , body ;
mount_decl ::= "mount" , identifier , body ;
skeleton_decl ::= "skeleton" , [ identifier ] , body ;
skin_decl ::= "skin" , body ;
morph_decl ::= "morph" , identifier , body ;
clip_decl ::= "clip" , identifier , body ;
lod_decl ::= "lod" , integer , body ;
collision_decl ::= "collision" , body ;
budget_decl ::= "budget" , body ;
variant_decl ::= "variant" , identifier , body ;
output_decl ::= "output" , identifier , body ;
view_decl ::= "view" , identifier , body ;
check_decl ::= "check" , identifier , body ;
accept_decl ::= "accept" , identifier , body ;
body ::= "{" , { _item } , "}" ;
_item ::= setting | row | sample_row | block | when_block | let_decl | part_decl | waiver ;
setting ::= _name , "=" , _value ;
_value ::= _expression | range | source_value ;
row ::= _name , "(" , argument , { "," , argument } , ")" ;
sample_row ::= "sample" , identifier , "in" , range , "by" , _expression , "->" , row ;
block ::= identifier , [ _declared_name ] , body ;
_declared_name ::= identifier | name_pair ;
name_pair ::= "(" , identifier , "," , identifier , ")" ;
when_block ::= "when" , _expression , body , [ "else" , (body | when_block) ] ;
waiver ::= "waive" , diagnostic_code , string ;
range ::= _expression , ".." , _expression ;
_expression ::= binary_expr | unary_expr | if_expr | call_expr | index_expr | member_expr | _primary ;
binary_expr ::= _expression , "||" , _expression | _expression , "&&" , _expression | _expression ,
                "==" , _expression | _expression , "!=" , _expression | _expression , "<" ,
                _expression | _expression , "<=" , _expression | _expression , ">" , _expression |
                _expression , ">=" , _expression | _expression , "+" , _expression | _expression ,
                "-" , _expression | _expression , "*" , _expression | _expression , "/" ,
                _expression ;
unary_expr ::= "-" , _expression | "+" , _expression | "!" , _expression ;
if_expr ::= "if" , _expression , "then" , _expression , "else" , _expression ;
call_expr ::= _name , "(" , [ argument , { "," , argument } ] , ")" ;
index_expr ::= _expression , "[" , _expression , "]" ;
member_expr ::= _expression , "." , identifier ;
argument ::= [ identifier , "=" ] , (_expression | range) ;
_primary ::= number | color | string | boolean | _name | tuple | list | paren_expr ;
paren_expr ::= "(" , _expression , ")" ;
tuple ::= "(" , _expression , "," , _expression , { "," , _expression } , ")" ;
list ::= "[" , [ _expression , { "," , _expression } , [ "," ] ] , "]" ;
boolean ::= "on" | "off" ;
_name ::= identifier | qualified_name ;
qualified_name ::= /[a-z_][a-z0-9_]*(\.[a-z_][a-z0-9_]*)+/ ;
number ::= /[0-9]+(\.[0-9]+)?(mm|cm|km|m|yd|ft|deg|rad|ms|s|px|%|KiB|MiB|GiB|B)?/ ;
integer ::= /[0-9]+/ ;
color ::= /#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?/ ;
string ::= /"([^"\\]|\\.)*"/ ;
identifier ::= /[a-z_][a-z0-9_]*/ ;
diagnostic_code ::= /GW-[A-Z0-9]+(-[A-Z0-9]+)*/ ;
comment ::= ///[^\n]*/ ;
