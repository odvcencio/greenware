greenware 1

// A rigged asset with a `check rig` audit. `greenware build` builds it. The
// browser worker, which always imposes `runtime_safe required`, refuses it
// with this code because the rig audit has no certified worker charge
// (internal/workerproto checks this fixture).

asset a { root = a idle = rest }

skeleton s { joint base { at = (0, 0, 0) } }

part a {
  joint = base
  sphere ball { radius = 0.1m at = (0, 0.1, 0) }
}

clip rest {
  duration = 1s
  pose { base = rot(0, 0, 0) }
}

check rig { ground = -5mm..20mm }

output demo { file = "a.glb" }
