greenware 1

// Two numeric runtime parameters give four corners and a default: five points.
// Under a `runtime_points` limit of 3 the audit runs the default and one axis
// at a time, and warns with this code. `greenware check` does not audit, so
// this fixture reports the code from `greenware build` with a limit below five.

asset a { root = a idle = rest }

param height : ratio = 1 in 0.9..1.1 runtime
param build : ratio = 0.5 in 0..1 runtime

skeleton s { joint base { at = (0, 0, 0) } }

part a {
  joint = base
  sphere ball { radius = 0.1m at = (0, 0.1, 0) }
}

clip rest {
  duration = 1s
  pose { base = rot(0, 0, 0) }
}

check runtime { corners = [height, build] }
check rig { ground = -5mm..20mm }

output demo { file = "a.glb" }
